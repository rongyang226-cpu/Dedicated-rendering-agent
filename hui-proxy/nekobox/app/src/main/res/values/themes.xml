        <item name="android:windowBackground">@color/hui_fallback</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="materialCardViewStyle">@style/HuiGlassCard</item>
        <item name="colorSurface">#A6FFFFFF</item>
        <item name="android:colorBackground">#00FFFFFF</item>
        <item name="windowActionModeOverlay">true</item>

        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>

        <item name="itemShapeAppearance">
            @style/ShapeAppearance.MaterialComponents.MediumComponent
        </item>

        <item name="alertDialogTheme">
