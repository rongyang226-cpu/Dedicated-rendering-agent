<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <gradient android:angle="135"
                android:startColor="#74FFFFFF"
                android:centerColor="#38FFE7F1"
                android:endColor="#42E8E2FF" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#C6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#12FFFFFF" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
        </shape>
    </item>
</selector>
