<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="315" android:startColor="#58FFFFFF" android:centerColor="#34FFFFFF" android:endColor="#46FFFFFF" />
            <corners android:radius="19dp" />
            <stroke android:width="1dp" android:color="#A0FFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="315" android:startColor="#42FFFFFF" android:centerColor="#26FFFFFF" android:endColor="#34FFFFFF" />
            <corners android:radius="19dp" />
            <stroke android:width="1dp" android:color="#78FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#40FFFFFF" android:centerColor="#20FFFFFF" android:endColor="#30FFFFFF" />
            <corners android:radius="19dp" />
            <stroke android:width="1dp" android:color="#72FFFFFF" />
        </shape>
    </item>
</selector>
